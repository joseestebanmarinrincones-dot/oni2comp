# ===========================================================================
# ps2-native-recomp / Onimusha 2 Android port
# Hybrid Android Studio (Gradle + NDK/CMake) and native C++ (SDL2/GLES/GLSL)
# ===========================================================================
#
# Rule of thumb: source, shaders and configuration stay; disc images, derived
# game data, build outputs, caches, logs and local secrets never enter git.
#
# Keep tracked:
#   *.c *.cc *.cpp *.cxx *.h *.hpp *.inl
#   *.glsl *.vert *.frag *.comp *.geom *.tesc *.tese *.wgsl *.hlsl *.metal
#   CMakeLists.txt *.cmake
#   *.gradle *.gradle.kts gradle.properties settings.gradle.kts
#   AndroidManifest.xml *.xml *.json *.md *.txt *.yml *.yaml
#
# ---------------------------------------------------------------------------
# Game images, executables and copyrighted data
# ---------------------------------------------------------------------------
# Disc images (Onimusha 2 is 3.78 GB; never commit it).
*.iso
*.ISO
*.chd
*.CHD
*.cso
*.CSO
*.cue
*.CUE
*.img
*.IMG
*.mdf
*.MDF
*.mds
*.MDS
*.nrg
*.NRG

# Raw game payloads, overlays, extracted RAM and PS2 modules.
*.bin
*.BIN
*.elf
*.ELF
*.irx
*.IRX
*.pss
*.PSS
*.adp
*.ADP
*.vag
*.VAG
*.ss2
*.SS2
*.spu
*.SPU
*.mpeg
*.MPEG
*.mpg
*.MPG
*.bik
*.BIK

# The executable named by the user and any disassembly derived from it.
SLUS_203.93
SLUS_203.93;1
SLUS_203.93.*
SLUS_*.???

# The Ghidra export requested alongside the source is the only allowed
# SLUS_203.93 artifact; raw game executables remain ignored.
!android/port/ghidra/**/*.gzf

# Local game dumps, analysis trees and translated game code.
# They contain the game's copyrighted bytes, overlays and derived work.
/games/
/isos/
/inis/
*.pnach

# Memory cards, save states and crash dumps from a running game.
*.ps2
*.PS2
*.mcd
*.MCD
*.mc2
*.MC2
*.sav
*.SAV
*.state
*.STATE
*.sstate
*.SSTATE
*.dmp
*.DMP
*.core
crash_log.txt
quickstate.qs
memcard0/

# Captures, recordings and extracted audio/video (the runner writes these).
*.ppm
*.PPM
*.wav
*.WAV
*.mp3
*.MP3
*.ogg
*.OGG
*.flac
*.FLAC
*.opus
*.OPUS
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
*.gif
*.GIF
*.bmp
*.BMP
*.webp
*.WEBP
*.mp4
*.MP4
*.webm
*.WEBM
*.avi
*.AVI
*.mkv
*.MKV

# Android app resources are source, not game captures.
!android/**/src/main/res/**/*.png
!android/**/src/main/res/**/*.webp
!android/**/src/main/res/**/*.jpg
!android/**/src/main/res/**/*.jpeg
!android/apk/res/**/*.png
!android/apk/res/**/*.webp
!android/apk/res/**/*.jpg
!android/apk/res/**/*.jpeg

